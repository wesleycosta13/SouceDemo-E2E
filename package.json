{
  "name": "saucedemo-e2e-playwright",
  "version": "1.0.0",
  "description": "Estrutura completa de automação de testes E2E com Playwright, TypeScript, POM, Fixtures, Faker.js e GitHub Actions",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
